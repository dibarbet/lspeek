<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\Client.Protocol\Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    <PackageReference Include="TextCopy" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Link="LICENSE.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lspeek</ToolCommandName>
    <PackageId>lspeek</PackageId>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Self-contained, platform-specific .NET tool published for every supported RID (.NET 10
      RID-specific tool packaging). Each frontend bundles a self-contained copy of the backend for
      the matching RID (see Bundle.Backend.targets) so the installed tool needs no separate .NET
      runtime. Both the frontend and the bundled backend are self-contained *JIT* builds, which
      cross-compile to any RID from any OS - so a single `dotnet pack` (no -r) on one runner
      auto-produces the routing manifest plus one self-contained payload per RID (see publish.yml),
      with no per-OS native-toolchain matrix. (The standalone lspeek-backend tool is additionally
      published native-AOT for win-x64/linux-x64; the bundled backend stays JIT so every frontend
      RID - including osx/arm64/musl - builds on a single runner.)

        * ToolPackageRuntimeIdentifiers lists the RIDs to pack and scopes self-contained packaging
          to `dotnet pack`, so normal `dotnet build`/`dotnet test` stay a plain, RID-agnostic
          managed build.
        * RuntimeIdentifiers (plural) makes a single `restore` produce assets for every RID, so the
          SDK's per-RID pack recursion finds them (no per-RID restore needed).
        * SelfContained applies only to the RID-specific payload builds (the JIT runtime ships in
          the payload); the no-RID manifest build stays framework-dependent and lightweight.
    -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <!-- Bundle lspeek-backend so the installed tool can spawn it off-repo. -->
  <Import Project="..\Bundle.Backend.targets" />

</Project>
