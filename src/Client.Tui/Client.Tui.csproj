<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\Client.Protocol\Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    <PackageReference Include="TextCopy" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Link="LICENSE.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MetaModel\metaModel.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lspeek.Tui</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lspeek</ToolCommandName>
    <PackageId>lspeek</PackageId>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Self-contained, ReadyToRun (R2R), platform-specific .NET tool published for every supported RID
      (.NET 10 RID-specific tool packaging). Each frontend bundles a self-contained copy of the backend
      for the matching RID (see Bundle.Backend.targets) so the installed tool needs no separate .NET
      runtime. Both the frontend and the bundled backend are self-contained R2R builds; R2R (crossgen2)
      cross-compiles to any RID from any OS - so a single `dotnet pack` (no -r) on one runner
      auto-produces the routing manifest plus one self-contained payload per RID (see publish.yml),
      with no per-OS native-toolchain matrix (the whole reason we use R2R instead of native AOT, which
      can't cross-compile).

        * ToolPackageRuntimeIdentifiers lists the RIDs to pack and scopes self-contained packaging
          to `dotnet pack`, so normal `dotnet build`/`dotnet test` stay a plain, RID-agnostic
          managed build.
        * RuntimeIdentifiers (plural) makes a single `restore` produce assets for every RID, so the
          SDK's per-RID pack recursion finds them (no per-RID restore needed).
        * SelfContained applies only to the RID-specific payload builds (the runtime ships in the
          payload); the no-RID manifest build stays framework-dependent and lightweight.
        * PublishReadyToRun is intentionally left unconditional. R2R only *executes* during a
          RID-specific publish (the SDK's CreateReadyToRunImages target runs only in the publish
          pipeline, never during `dotnet build`/`dotnet test`), but the property must be true during
          the single RID-agnostic restore so the SDK adds the crossgen2 compiler pack to the assets.
          The per-RID payload publishes reuse that restore without restoring again, so gating
          PublishReadyToRun on a RID makes restore skip crossgen2 and the payload publish then fails
          with NETSDK1094 ("a valid runtime package was not found") on a clean machine (a populated
          local NuGet cache hides it, so it only reproduces in CI).
    -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Bundle lspeek-http so the installed tool can spawn it off-repo. -->
  <Import Project="..\Bundle.Backend.targets" />

</Project>
