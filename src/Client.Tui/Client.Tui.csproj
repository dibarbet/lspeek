<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\Client.Protocol\Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    <PackageReference Include="TextCopy" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Link="LICENSE.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lspeek</ToolCommandName>
    <PackageId>lspeek</PackageId>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Self-contained, platform-specific .NET tool (.NET 10 RID-specific tool packaging). The TUI
      bundles the native-AOT backend for the matching RID (see Bundle.Backend.targets), so it must
      itself be platform-specific. `dotnet pack` emits a routing manifest; `dotnet pack -r <rid>`
      emits the self-contained payload for that RID (packed per-OS - see publish.yml).

        * ToolPackageRuntimeIdentifiers scopes the RID set to packaging, so normal
          `dotnet build`/`dotnet test` stay a plain, RID-agnostic managed build.
        * SelfContained applies only to the RID-specific inner builds (the JIT runtime ships in
          the payload); the no-RID manifest build stays framework-dependent and lightweight.
        * The SDK would otherwise auto-create the per-RID payloads from one `dotnet pack`, trying
          to cross-compile every RID's native-AOT backend on a single OS (impossible). Declaring
          PublishAot during the no-RID manifest pack flips the SDK's _InnerToolsPublishAot guard
          so it skips that auto-recursion; it's gated to the manifest pack only, so the frontend
          itself is never AOT-compiled (the SDK forces PublishAot=false before the manifest's own
          publish, and the RID payloads remain plain self-contained JIT builds).
    -->
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64</ToolPackageRuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishAot Condition="'$(RuntimeIdentifier)' == '' and '$(_IsPacking)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <!-- Bundle lspeek-backend so the installed tool can spawn it off-repo. -->
  <Import Project="..\Bundle.Backend.targets" />

</Project>
