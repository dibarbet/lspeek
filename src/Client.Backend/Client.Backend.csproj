<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ManualLspClient.Backend</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>lspeek-backend</AssemblyName>
    <!--
      Pack the backend as a `dnx`-launchable .NET tool so frontends that can't bundle it
      (the JS canvas extension) can acquire it from NuGet with `dotnet dnx lspeek-backend`
      instead of relying on a local repo build. The web UI is an EmbeddedResource compiled
      into lspeek-backend.dll, so the tool package is fully self-describing.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lspeek-backend</ToolCommandName>
    <PackageId>lspeek-backend</PackageId>
    <IsPackable>true</IsPackable>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Native-AOT, platform-specific .NET tool (.NET 10 multi-RID tool packaging).
      `dotnet pack` produces a per-RID package for each concrete RID plus a top-level
      manifest package, and `dnx`/`dotnet tool install` auto-selects the matching RID.
      Concrete RIDs are AOT-compiled (no shared runtime needed); the `any` RID is a
      framework-dependent fallback for platforms we don't ship native binaries for.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64;any</RuntimeIdentifiers>
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Source-generate the minimal-API endpoints and keep the AOT/trim analyzers on for
      every build (not just `publish -r <rid>`), so regressions in the backend's own
      reachable code surface immediately. Referenced libraries (Client.Core/Protocol)
      keep their reflection-based JSON helpers for the non-AOT frontends; those are
      unreachable here and trimmed by ILC at publish time.
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\Client.Protocol\Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUi\index.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Link="LICENSE.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
