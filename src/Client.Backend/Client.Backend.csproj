<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ManualLspClient.Backend</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>lspeek-backend</AssemblyName>
    <!--
      Pack the backend as a `dnx`-launchable .NET tool so frontends that can't bundle it
      (the JS canvas extension) can acquire it from NuGet with `dotnet dnx lspeek-backend`
      instead of relying on a local repo build. The web UI is an EmbeddedResource compiled
      into lspeek-backend.dll, so the tool package is fully self-describing.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lspeek-backend</ToolCommandName>
    <PackageId>lspeek-backend</PackageId>
    <IsPackable>true</IsPackable>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Native-AOT, platform-specific .NET tool (.NET 10 RID-specific tool packaging).
      ToolPackageRuntimeIdentifiers (rather than RuntimeIdentifiers) scopes the RID set to
      tool packaging only, so normal `dotnet build`/`dotnet test` of the backend stay a plain
      managed build. Because PublishAot is set, the SDK does NOT auto-create the per-RID
      payloads (AOT can't cross-compile), so packaging is a two-step, per-OS flow:
        * `dotnet pack`                         -> top-level manifest package (routing only)
        * `dotnet pack -r win-x64`              -> win-x64 native-AOT payload   (on Windows)
        * `dotnet pack -r linux-x64`            -> linux-x64 native-AOT payload (on Linux)
        * `dotnet pack -r any -p:PublishAot=false` -> framework-dependent `any` fallback
      `dnx`/`dotnet tool install lspeek-backend` reads the manifest and fetches the matching
      RID payload, so the canvas keeps acquiring one universal id with no change.
    -->
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;any</ToolPackageRuntimeIdentifiers>
    <!--
      RuntimeIdentifiers (plural) is restore-only: it makes a single top-level `restore` produce
      multi-RID assets for this project. The frontends bundle a self-contained (JIT) copy of the
      backend per RID; the SDK packs those frontend RIDs in parallel, and each inner pack only
      *publishes* (never restores) the backend, so the backend's assets must already cover every
      RID. It does NOT change this tool's own packaging: _UserSpecifiedToolPackageRids prefers
      ToolPackageRuntimeIdentifiers above, and PublishAot=true keeps the SDK from auto-creating
      per-RID payloads here (AOT can't cross-compile - see the two-step flow above).
    -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Source-generate the minimal-API endpoints and keep the AOT/trim analyzers on for
      every build (not just `publish -r <rid>`), so regressions in the backend's own
      reachable code surface immediately. Referenced libraries (Client.Core/Protocol)
      keep their reflection-based JSON helpers for the non-AOT frontends; those are
      unreachable here and trimmed by ILC at publish time.
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      The backend self-hosts Kestrel and serves its UI from an embedded resource, and the
      native-AOT tool runs the executable directly (never under IIS). Disable the web-publish
      machinery that would otherwise emit web.config / static-web-assets manifests.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- Size/symbol optimizations that only apply to the native-AOT payload builds. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- Don't ship debug symbols in the tool package (the native PDB alone is ~55 MB). -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Plain SDK + an explicit ASP.NET Core framework reference (instead of Microsoft.NET.Sdk.Web)
      so the published tool doesn't carry IIS/static-web-assets cruft (web.config,
      aspnetcorev2_inprocess.dll, *.staticwebassets.endpoints.json). The backend self-hosts
      Kestrel and serves its UI from an embedded resource, so none of that is needed.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Re-add the global usings the Web SDK provides, since we use the plain SDK. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\Client.Protocol\Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUi\index.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Link="LICENSE.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <!--
    Belt-and-suspenders: drop publish artifacts that have no purpose in a native-AOT tool
    package (reference PDBs, plus the IIS in-process shim should the AspNetCore framework
    targets still emit it), so the package contains just the native executable +
    DotnetToolSettings.xml.
  -->
  <Target Name="_StripBackendToolCruftFromPublish"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">
    <ItemGroup>
      <_BackendPublishCruft Include="$(PublishDir)**\*.pdb" />
      <_BackendPublishCruft Include="$(PublishDir)**\aspnetcorev2_inprocess.dll" />
      <_BackendPublishCruft Include="$(PublishDir)**\web.config" />
      <_BackendPublishCruft Include="$(PublishDir)**\*.staticwebassets.endpoints.json" />
    </ItemGroup>
    <Delete Files="@(_BackendPublishCruft)" />
  </Target>

</Project>
