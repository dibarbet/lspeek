<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lspeek.Backend</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>lspeek-http</AssemblyName>
    <!--
      Pack the backend as a `dnx`-launchable .NET tool so frontends that can't bundle it
      (the JS canvas extension) can acquire it from NuGet with `dotnet dnx lspeek-http`
      instead of relying on a local repo build. The web UI is an EmbeddedResource compiled
      into lspeek-http.dll, so the tool package is fully self-describing.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lspeek-http</ToolCommandName>
    <PackageId>lspeek-http</PackageId>
    <IsPackable>true</IsPackable>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Self-contained, trimmed, ReadyToRun (R2R), platform-specific .NET tool (.NET 10 RID-specific
      tool packaging). Unlike native AOT, R2R (crossgen2) cross-compiles to any OS/arch from a single
      runner, so the SDK auto-produces every per-RID payload from one ordinary pack - no per-OS
      native-toolchain matrix and no two-step flow:
        * `dotnet pack`  -> routing manifest + one self-contained R2R payload per RID, all on one runner.
      `dnx`/`dotnet tool install lspeek-http` reads the manifest and fetches the matching RID
      payload, so the canvas keeps acquiring one universal id with no change.

      ToolPackageRuntimeIdentifiers (rather than RuntimeIdentifiers) scopes the per-RID self-contained
      packaging to `dotnet pack`, so normal `dotnet build`/`dotnet test` of the backend stay a plain,
      RID-agnostic managed build.
    -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <!--
      RuntimeIdentifiers (plural) is restore-only: it makes a single top-level `restore` produce
      multi-RID assets for this project. The frontends bundle a self-contained copy of the backend
      per RID; the SDK packs those frontend RIDs in parallel, and each inner pack only *publishes*
      (never restores) the backend, so the backend's assets must already cover every RID.
    -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!--
      Per-RID payload builds are self-contained, ReadyToRun, and trimmed. SelfContained and
      PublishTrimmed take effect only for RID-specific publishes; the no-RID routing manifest and
      local `dotnet build`/`dotnet test` stay a plain framework-dependent managed build.

      PublishReadyToRun is intentionally NOT conditioned on the RID. R2R only *executes* during a
      RID-specific self-contained publish (the SDK's CreateReadyToRunImages target runs only in the
      publish pipeline, never during `dotnet build`/`dotnet test`), so leaving it on doesn't change
      local builds. But the property must be true during the single, RID-agnostic top-level restore:
      that's when the SDK adds the crossgen2 compiler pack to the restore graph for the RIDs. The
      inner per-RID payload publishes run without restoring (the SDK reuses the top-level restore),
      so everything they need (runtime packs, ILLink, crossgen2) must already be restored.
      Conditioning PublishReadyToRun on '$(RuntimeIdentifier)' != '' makes it false at restore time,
      so crossgen2 is never restored and the per-RID R2R publish fails on a clean machine with
      NETSDK1094 ("a valid runtime package was not found") - which only reproduces in CI, since a
      populated local NuGet cache hides it. This mirrors how the unconditional IsAotCompatible below
      keeps the ILLink pack restored.
    -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != ''">true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Source-generate the minimal-API endpoints and keep the AOT/trim analyzers on for every build
      (not just `publish -r <rid>`), so trim regressions in the backend's own reachable code surface
      immediately. We ship R2R + trimmed (not native AOT, which can't cross-compile), but keeping
      IsAotCompatible on means the backend also stays AOT-clean for free. Referenced libraries
      (Client.Core/Protocol) keep their reflection-based JSON helpers for the non-trimmed frontends;
      those are unreachable here and removed by the trimmer at publish time.
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      The backend self-hosts Kestrel and serves its UI from an embedded resource, and the tool runs
      the executable directly (never under IIS). Disable the web-publish machinery that would
      otherwise emit web.config / static-web-assets manifests.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- Keep the per-RID self-contained payload lean: don't ship debug symbols in the tool package. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Plain SDK + an explicit ASP.NET Core framework reference (instead of Microsoft.NET.Sdk.Web)
      so the published tool doesn't carry IIS/static-web-assets cruft (web.config,
      aspnetcorev2_inprocess.dll, *.staticwebassets.endpoints.json). The backend self-hosts
      Kestrel and serves its UI from an embedded resource, so none of that is needed.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Re-add the global usings the Web SDK provides, since we use the plain SDK. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\Client.Protocol\Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUi\index.html" />
    <EmbeddedResource Include="WebUi\logExport.mjs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Link="LICENSE.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <!--
    Belt-and-suspenders: drop publish artifacts that have no purpose in a self-contained tool
    package (PDBs, plus the IIS in-process shim / web.config should the AspNetCore framework
    targets still emit them), so the package contains just the runtime + app + apphost +
    DotnetToolSettings.xml.
  -->
  <Target Name="_StripBackendToolCruftFromPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_BackendPublishCruft Include="$(PublishDir)**\*.pdb" />
      <_BackendPublishCruft Include="$(PublishDir)**\aspnetcorev2_inprocess.dll" />
      <_BackendPublishCruft Include="$(PublishDir)**\web.config" />
      <_BackendPublishCruft Include="$(PublishDir)**\*.staticwebassets.endpoints.json" />
    </ItemGroup>
    <Delete Files="@(_BackendPublishCruft)" />
  </Target>

</Project>
