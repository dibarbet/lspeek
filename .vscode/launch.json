{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Client.Tui (roslyn)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Client.Tui",
      "cwd": "${workspaceFolder}",
      "args": [
        "roslyn"
      ],
      "console": "externalTerminal",
      "stopAtEntry": false,
      "windows": {
        "program": "${workspaceFolder}/src/Client.Tui/bin/Debug/net10.0/win-x64/Client.Tui.dll"
      },
      "linux": {
        "program": "${workspaceFolder}/src/Client.Tui/bin/Debug/net10.0/linux-x64/Client.Tui.dll"
      },
      "osx": {
        "program": "${workspaceFolder}/src/Client.Tui/bin/Debug/net10.0/osx-arm64/Client.Tui.dll"
      }
    }
  ]
}