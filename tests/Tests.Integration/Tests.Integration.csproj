<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nerdbank.Streams" Version="*" />
    <PackageReference Include="StreamJsonRpc" Version="2.24.84" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\..\src\Client.Protocol\Client.Protocol.csproj" />
    <!-- The TUI session log (SessionLog / SessionMessage / progress tracker) is exercised by the harness. -->
    <ProjectReference Include="..\..\src\Client.Tui\Client.Tui.csproj" />
    <!--
      Real reference: gives the E2E tests the MCP tool surface (LspTools / BackendSession) to drive.
      Client.Mcp also imports Bundle.Backend.targets, so building it builds lspeek-http too.
    -->
    <ProjectReference Include="..\..\src\Client.Mcp\Client.Mcp.csproj" />
    <!--
      Build-only references (ReferenceOutputAssembly=false): we don't link these assemblies, we just
      need their build outputs on disk for the E2E fixture to spawn. Client.Backend produces the
      lspeek-http host the BackendClient launches (via LSPEEK_HTTP); FakeLspServer.Host produces the
      lspeek-fake-lsp "language server" the backend is pointed at.
    -->
    <ProjectReference Include="..\..\src\Client.Backend\Client.Backend.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\FakeLspServer.Host\FakeLspServer.Host.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
